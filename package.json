{
  "name": "scout-cat",
  "version": "0.1.0",
  "description": "情报猎猫 - AI 情报桌面宠物",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "prestart": "electron-vite build",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.scoutcat.app",
    "productName": "情报猎猫",
    "artifactName": "scout-cat-${version}-${os}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "longcat.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "longcat.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "情报猎猫"
    },
    "portable": {
      "artifactName": "scout-cat-${version}-portable.${ext}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/konka0812/scout-cat.git"
  }
}
